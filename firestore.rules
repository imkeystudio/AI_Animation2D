rules_version = '2';
// AI_animation usage data. A signed-in user writes only their own records; only admins (an email listed in the
// "admins" collection, document id = the email in lower case) read everyone's data. Paste into Firestore → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }
    // the profile: the owner creates and updates it (never changes its uid); admins read all
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid;
      allow delete: if isAdmin();
    }
    // the auto-rig library: each user's own animations and packs (only they read and write them)
    match /users/{uid}/anims/{id} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    // sessions and events: a user adds and updates only records carrying their own uid
    match /sessions/{id} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }
    match /events/{id} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    // admins: a signed-in user may check only their own entry (to show the dashboard link); set them in the console
    match /admins/{email} {
      allow read: if signedIn() && (request.auth.token.email.lower() == email || isAdmin());
      allow write: if false;
    }
  }
}
